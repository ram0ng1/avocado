{
    "name": "ramon/avocado",
    "description": "A modern, performance minded theme for Flarum 2",
    "keywords": [
        "flarum",
        "theme"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Sami Mazouz",
            "email": "ilyasmazouz@gmail.com",
            "homepage": "https://www.buymeacoffee.com/sycho",
            "role": "Developer"
        },
        {
            "name": "Ramon Guilherme",
            "email": "ramon@ramonguilherme.com.br",
            "homepage": "https://ramonguilherme.com.br",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ram0ng1/avocado/issues",
        "source": "https://github.com/ram0ng1/avocado",
        "forum": "https://discuss.flarum.org/d/38940-avocado-theme"
    },
    "funding": [
        {
            "type": "website",
            "url": "https://donate.stripe.com/fZe5o66nebkf39S28a"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0"
    },
    "require-dev": {
        "flarum/tags": "^2.0.0",
        "flarum/likes": "^2.0.0",
        "flarum/phpstan": "^2.0",
        "flarum/sticky": "^2.0.0",
        "flarum/testing": "^2.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5 || ^13.2.0",
        "roave/security-advisories": "dev-latest"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse --memory-limit=2G",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit -c tests/phpunit.integration.xml"
        ],
        "test:setup": "@php tests/integration/setup.php"
    },
    "suggest": {
        "flarum/tags": "Required for the showcase widget and tag-based hero images (^2.0)."
    },
    "autoload": {
        "psr-4": {
            "Ramon\\Avocado\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ramon\\Avocado\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev"
        },
        "flarum-extension": {
            "title": "Avocado",
            "category": "theme",
            "icon": {
                "image": "icon.svg"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "gitConf": true,
                "prettier": true,
                "typescript": true,
                "backendTesting": true,
                "editorConfig": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    }
}
