{
    "name": "ramon/avocado",
    "description": "A modern, feature-rich Flarum theme with advanced search, real-time messaging, and comprehensive multi-language support. Built on the Avocado foundation with significant enhancements.",
    "keywords": [
        "flarum",
        "theme"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Sami Mazouz",
            "email": "ilyasmazouz@gmail.com",
            "homepage": "https://www.buymeacoffee.com/sycho",
            "role": "Developer"
        },
        {
            "name": "Ramon Guilherme",
            "email": "ramon@ramonguilherme.com.br",
            "homepage": "https://ramonguilherme.com.br",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ram0ng1/avocado/issues",
        "source": "https://github.com/ram0ng1/avocado",
        "forum": "https://discuss.flarum.org/d/38940-avocado-theme"
    },
    "funding": [
        {
            "type": "website",
            "url": "https://donate.stripe.com/fZe5o66nebkf39S28a"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0"
    },
    "require-dev": {
        "flarum/tags": "^2.0.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "test": "phpunit",
        "test-security": "phpunit --group security",
        "analyse": "phpstan analyse"
    },
    "suggest": {
        "flarum/tags": "Required for the showcase widget and tag-based hero images (^2.0)."
    },
    "autoload": {
        "psr-4": {
            "Ramon\\Avocado\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ramon\\Avocado\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev"
        },
        "flarum-extension": {
            "title": "Avocado",
            "category": "theme",
            "icon": {
                "image": "icon.svg"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "gitConf": true,
                "prettier": true,
                "typescript": true,
                "backendTesting": false,
                "editorConfig": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
