# Keep development, CI and test infrastructure OUT of the distributed composer
# package (Packagist dist tarball / `composer archive`). Consumers installing via
# `composer require ramon/avocado` only need src/, js/dist, locale/, migrations/,
# resources/, extend.php and composer.json — not the test suite or tooling.
#
# `require-dev` dependencies (phpunit, mockery) are never installed for consumers
# anyway; export-ignore here removes the test FILES from the shipped archive too.

/.github            export-ignore
/tests              export-ignore
/js/src             export-ignore
/js/node_modules    export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/.prettierrc        export-ign  ore
/phpunit.xml.dist   export-ignore
/.phpunit.cache     export-ignore
/phpstan.neon       export-ignore
/phpstan-baseline.neon export-ignore
